// Cloudflare Workers configuration for the Caribbean Business frontend
// (built with @opennextjs/cloudflare). See replit.md → "Cloudflare Workers".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caribbean-business",
  // Wraps .open-next/worker.js (generated by the build); see that file.
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Test URL: https://caribbean-business.<account-subdomain>.workers.dev
  "workers_dev": true,
  "preview_urls": false,
  // Runtime configuration (Stripe, Recombee, R2, ...) is set on the Worker in
  // the Cloudflare dashboard, never in this file. Keep plain-text variables
  // set there across deploys (secrets are always kept).
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self reference used by the ISR revalidation queue.
      // Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "caribbean-business",
    },
  ],
  "r2_buckets": [
    {
      // ISR incremental cache. Private bucket, NOT the public image bucket
      // behind img.caribbean.business. Create once with:
      //   npx wrangler r2 bucket create caribbean-business-opennext-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "caribbean-business-opennext-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        // ISR revalidation queue (deduplicates background regenerations).
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  "images": {
    // next/image optimization through Cloudflare Images (billed per unique
    // transformation). Allowed hosts still come from lib/imageHosts.js.
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
}
