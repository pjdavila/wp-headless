# Your WordPress site URL
NEXT_PUBLIC_WORDPRESS_URL=https://faustexample.wpengine.com

# Plugin secret found in WordPress Settings->Headless
# FAUST_SECRET_KEY=YOUR_PLUGIN_SECRET

# The URL of your site, used by Faust for sitemap generation, however you can name this whatever you want.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paid print edition subscription (/subscription/). Without these the
# checkout, webhook and customer-portal endpoints fail with a clear error.
# Secret API key from the Stripe dashboard (Developers -> API keys).
# STRIPE_SECRET_KEY=sk_live_...
# Signing secret for the webhook endpoint (Developers -> Webhooks ->
# /api/stripe-print-webhook), or from `stripe listen` in test mode.
# STRIPE_WEBHOOK_SECRET=whsec_...
# ID of the recurring $4.99 USD monthly price created in the Stripe dashboard.
# STRIPE_PRICE_ID_MONTHLY=price_...
# Team inbox that receives a notice for every new print signup (paid or waitlist).
# PRINT_EDITION_NOTIFY_EMAIL=equipo@example.com
# Public URL of THIS frontend (not the WordPress CMS). Used as the allowlisted
# origin for Stripe checkout/portal return links.
# NEXT_PUBLIC_APP_URL=https://caribbean.business
# Also required for the subscription flow: SESSION_SECRET (signs the
# manage-subscription magic links) and RESEND_API_KEY (sends those emails).
