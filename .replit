modules = ["nodejs-20", "web", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NEXT_PUBLIC_WORDPRESS_URL = "https://cms.vnmedia.co/cbusiness"
NEXT_PUBLIC_SITE_URL = "https://cms.vnmedia.co/cbusiness"
COMING_SOON = "true"
NEXT_PUBLIC_COMING_SOON = "true"
RECOMBEE_REGION = "ca-east"
MOOSEND_LIST_ID = "6bab64cd-1fd8-4d35-b7e3-4bb791fc7575"
FORTY_UNDER_40_WEBHOOK_URL = "https://bab58e2e-aabe-4bc1-9d0a-ee3192e000b1-00-3tcod28zrxfgz-33erfqfo.kirk.replit.dev/api/forms-webhook/40-under-40-caribbean-business"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3001

[[ports]]
localPort = 5055
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
